#!/usr/bin/env python3
"""Tiny Codex CLI protocol simulator for Tiffany smoke tests."""

import json
import os
import sys


def append_log(args, prompt):
    path = os.environ.get("TIFFANY_FAKE_CODEX_LOG")
    if not path:
        return
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"args": args, "prompt": prompt}, ensure_ascii=False))
        handle.write("\n")


def emit(value):
    print(json.dumps(value, ensure_ascii=False), flush=True)


def short_text(text, limit=180):
    compact = " ".join(text.split())
    if len(compact) > limit:
        return compact[: limit - 1] + "…"
    return compact


def main():
    args = sys.argv[1:]
    prompt = args[-1] if args else ""
    append_log(args, prompt)
    thread_id = os.environ.get("TIFFANY_FAKE_CODEX_SESSION", "fake-codex-native-session")

    emit({"type": "session_configured", "thread_id": thread_id, "model": "fake-codex"})
    if os.environ.get("TIFFANY_FAKE_CODEX_FAIL_WORKER") == "1":
        print("Fake Codex worker failed intentionally for Tiffany e2e.", file=sys.stderr)
        return 43

    answer = "Fake Codex worker completed the Tiffany multi-runtime smoke run."
    if prompt.strip():
        answer += f" Prompt: {short_text(prompt)}"
    emit(
        {
            "type": "message",
            "thread_id": thread_id,
            "role": "assistant",
            "content": [{"type": "text", "text": answer}],
        }
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
