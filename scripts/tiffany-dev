#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_dir/scripts/lib/tiffany-cargo.sh"

tiffany_home="${TIFFANY_HOME:-${HOME:-}/.tiffany}"
if [[ "$tiffany_home" == "/.tiffany" ]]; then
  echo "TIFFANY_HOME is not set and HOME is unavailable" >&2
  exit 1
fi
mkdir -p "$tiffany_home"
export TIFFANY_HOME="$tiffany_home"
export TIFFANY_SQLITE_HOME="${TIFFANY_SQLITE_HOME:-$tiffany_home}"
export CODEX_HOME="$tiffany_home"
export CODEX_SQLITE_HOME="$TIFFANY_SQLITE_HOME"

cargo_bin="$(tiffany_resolve_cargo)"

target_dir="${TIFFANY_CARGO_TARGET_DIR:-${CARGO_TARGET_DIR:-$repo_dir/target}}"
case "$target_dir" in
  /*) ;;
  *) target_dir="$repo_dir/$target_dir" ;;
esac
export CARGO_TARGET_DIR="$target_dir"

root_package_version() {
  awk '
    /^\[package\]/ { in_package = 1; next }
    /^\[/ && in_package { exit }
    in_package && $1 == "version" {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  ' "$repo_dir/Cargo.toml"
}

expected_version="$(root_package_version)"
if [[ -z "$expected_version" ]]; then
  echo "Could not read root package version from Cargo.toml" >&2
  exit 1
fi

usage() {
  cat <<'EOF'
tiffany-dev - run tiffany-loop from this source checkout

Usage:
  ./scripts/tiffany-dev
      Build ./target/dev-small/orchestrator and ./target/dev-small/tiffany-loop
      when needed, then open the local tiffany-loop TUI in orchestrator mode.
      This is the source-checkout equivalent of running installed `tiffany-loop`.

  ./scripts/tiffany-dev orchestrator ["prompt"...]
      Open the local TUI and route input through the orchestrator runtime.

  ./scripts/tiffany-dev config ...
  ./scripts/tiffany-dev setup
  ./scripts/tiffany-dev roles|status|doctor|init|sessions|usage|events|acp ...
      Run the local orchestrator CLI directly. These commands do not open the
      TUI and do not require a tiffany-loop UI login.

  ./scripts/tiffany-dev orchestrator --legacy ...
      Use the legacy orchestrator terminal bridge.

  ./scripts/tiffany-dev -- <raw tiffany-loop args>
      Pass arguments through to the local tiffany-loop binary.

In the TUI:
  /provider     configure provider credentials and endpoints
  /role         register planner/critic/worker/reviewer roles
  /roles        inspect current role -> provider -> model -> runtime wiring
  /thread       inspect or clear stable worker sessions
  /doctor       diagnose provider/model/key/runtime problems
  /status       show current orchestration status
  /copy         copy the last assistant answer
  /raw          toggle copy-friendly raw scrollback mode

Environment:
  TIFFANY_HOME              UI config/state root, default: ~/.tiffany
  TIFFANY_SQLITE_HOME       UI SQLite root, default: $TIFFANY_HOME
  TIFFANY_ORCHESTRATOR_BIN  Orchestrator binary used by tiffany-loop
  TIFFANY_CARGO_TARGET_DIR  shared Cargo target dir, default: ./target
  TIFFANY_DEV_PROFILE       Cargo profile for local binaries, default: dev-small
                            Set to dev for full debug symbols.
  TIFFANY_DEV_CARGO_RUN=1   use cargo run for the tiffany-loop binary instead of
                            reusing ./target/<profile>/tiffany-loop
  CARGO                     Cargo executable, default: cargo
EOF
}

dev_profile="${TIFFANY_DEV_PROFILE:-dev-small}"
if [[ -z "$dev_profile" ]]; then
  dev_profile="dev-small"
fi
if [[ "$dev_profile" == "debug" ]]; then
  dev_profile="dev"
fi

profile_dir() {
  if [[ "$dev_profile" == "dev" ]]; then
    printf '%s/debug' "$target_dir"
  else
    printf '%s/%s' "$target_dir" "$dev_profile"
  fi
}

cargo_profile_args=()
if [[ "$dev_profile" != "dev" ]]; then
  cargo_profile_args=(--profile "$dev_profile")
fi

binary_version() {
  local binary="$1"
  local output
  if [[ ! -x "$binary" ]]; then
    return 1
  fi
  output="$("$binary" --version 2>/dev/null)" || return 1
  awk '{print $2}' <<<"$output"
}

needs_rebuild() {
  local binary="$1"
  local actual
  actual="$(binary_version "$binary" || true)"
  [[ "$actual" != "$expected_version" ]]
}

build_orchestrator_bin() {
  (cd "$repo_dir" && "$cargo_bin" build "${cargo_profile_args[@]}" --bin orchestrator)
}

build_tiffany_bin() {
  (cd "$repo_dir/tiffany-ui/codex-rs" && "$cargo_bin" build "${cargo_profile_args[@]}" -p tiffany-cli --bin tiffany-loop --bin tiffany)
}

ensure_orchestrator_bin() {
  if [[ -n "${TIFFANY_ORCHESTRATOR_BIN:-}" ]]; then
    orchestrator_bin="$TIFFANY_ORCHESTRATOR_BIN"
    if [[ ! -x "$orchestrator_bin" ]]; then
      echo "TIFFANY_ORCHESTRATOR_BIN is not executable: $orchestrator_bin" >&2
      exit 1
    fi
    actual_version="$(binary_version "$orchestrator_bin" || true)"
    if [[ -n "$actual_version" && "$actual_version" != "$expected_version" ]]; then
      echo "warning: TIFFANY_ORCHESTRATOR_BIN version $actual_version does not match source $expected_version: $orchestrator_bin" >&2
    fi
    return
  fi

  orchestrator_bin="$(profile_dir)/orchestrator"
  if needs_rebuild "$orchestrator_bin"; then
    build_orchestrator_bin
  fi
}

run_orchestrator_cli() {
  ensure_orchestrator_bin
  case "${1:-}" in
    doctor|status)
      ensure_tiffany_bin
      ;;
  esac
  exec "$orchestrator_bin" "$@"
}

ensure_tiffany_bin() {
  tiffany_bin="$(profile_dir)/tiffany-loop"
  if [[ "${TIFFANY_DEV_CARGO_RUN:-0}" == "1" ]]; then
    return
  fi

  if needs_rebuild "$tiffany_bin"; then
    build_tiffany_bin
  fi
}

run_tiffany() {
  ensure_tiffany_bin
  if [[ "${TIFFANY_DEV_CARGO_RUN:-0}" == "1" ]]; then
    cd "$repo_dir/tiffany-ui/codex-rs"
    exec "$cargo_bin" run "${cargo_profile_args[@]}" -p tiffany-cli --bin tiffany-loop -- "$@"
  fi

  exec "$tiffany_bin" "$@"
}

if [[ "$#" == "0" ]]; then
  ensure_orchestrator_bin
  run_tiffany orchestrator --bin "$orchestrator_bin"
fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
  usage
  exit 0
fi

case "${1:-}" in
  config|setup|roles|status|doctor|init|sessions|usage|events|acp)
    run_orchestrator_cli "$@"
    ;;
esac

if [[ "${1:-}" == "--" ]]; then
  shift
fi

if [[ "${1:-}" == "orchestrator" || "${1:-}" == "orch" || "${1:-}" == "team" ]]; then
  subcommand="$1"
  shift

  has_bin_arg=0
  for arg in "$@"; do
    if [[ "$arg" == "--bin" || "$arg" == --bin=* ]]; then
      has_bin_arg=1
      break
    fi
  done

  if [[ "$has_bin_arg" == "0" ]]; then
    ensure_orchestrator_bin

    if [[ "$#" == "0" ]]; then
      run_tiffany "$subcommand" --bin "$orchestrator_bin"
    fi
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
      run_tiffany "$subcommand" "$@"
    fi
    if [[ "${1:-}" == "--" ]]; then
      shift
    fi
    run_tiffany "$subcommand" --bin "$orchestrator_bin" "$@"
  fi

  run_tiffany "$subcommand" "$@"
fi

run_tiffany "$@"
