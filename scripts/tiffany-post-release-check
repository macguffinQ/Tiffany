#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./scripts/tiffany-post-release-check --tag vX.Y.Z [options]

Verifies the published GitHub Release, Homebrew tap formula, and local Homebrew
install surface for a release tag.

Options:
  --tag TAG        Release tag to verify.
  --repo REPO      GitHub release repo. Default: macguffinQ/Tiffany.
  --tap REPO       Homebrew tap repo. Default: macguffinQ/tap.
  --tap-dir DIR    Existing Homebrew tap checkout to verify instead of `brew --repository`.
  --formula NAME   Formula name. Default: tiffany-loop.
  --skip-install   Skip brew update/upgrade/test and only verify release + tap metadata.

Examples:
  ./scripts/tiffany-post-release-check --tag vX.Y.Z
  ./scripts/tiffany-post-release-check --tag vX.Y.Z --tap-dir ../homebrew-tap --skip-install
EOF
}

sha256_stream() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    echo "sha256sum or shasum is required" >&2
    exit 1
  fi
}

homebrew_tap_name() {
  local repo="$1"
  local owner="${repo%%/*}"
  local name="${repo#*/}"
  if [[ -n "$owner" && "$name" == homebrew-* && "$owner/$name" == "$repo" ]]; then
    printf '%s/%s\n' "$owner" "${name#homebrew-}"
  else
    printf '%s\n' "$repo"
  fi
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "$1 is required" >&2
    exit 1
  fi
}

tag=""
release_repo="macguffinQ/Tiffany"
tap_repo="macguffinQ/tap"
tap_dir=""
formula_name="tiffany-loop"
skip_install=false

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --tag)
      if [[ -z "${2:-}" ]]; then
        usage >&2
        exit 2
      fi
      tag="$2"
      shift
      ;;
    --tag=*)
      tag="${1#--tag=}"
      ;;
    --repo)
      if [[ -z "${2:-}" ]]; then
        usage >&2
        exit 2
      fi
      release_repo="$2"
      shift
      ;;
    --repo=*)
      release_repo="${1#--repo=}"
      ;;
    --tap)
      if [[ -z "${2:-}" ]]; then
        usage >&2
        exit 2
      fi
      tap_repo="$2"
      shift
      ;;
    --tap=*)
      tap_repo="${1#--tap=}"
      ;;
    --tap-dir)
      if [[ -z "${2:-}" ]]; then
        usage >&2
        exit 2
      fi
      tap_dir="$2"
      shift
      ;;
    --tap-dir=*)
      tap_dir="${1#--tap-dir=}"
      ;;
    --formula)
      if [[ -z "${2:-}" ]]; then
        usage >&2
        exit 2
      fi
      formula_name="$2"
      shift
      ;;
    --formula=*)
      formula_name="${1#--formula=}"
      ;;
    --skip-install)
      skip_install=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -z "$tag" ]]; then
  usage >&2
  exit 2
fi

require_cmd gh
require_cmd curl
if [[ -z "$tap_dir" || "$skip_install" != "true" ]]; then
  require_cmd brew
fi

version="${tag#v}"
assets=(
  "tiffany-loop-${tag}-aarch64-apple-darwin.tar.gz"
  "tiffany-loop-${tag}-x86_64-apple-darwin.tar.gz"
  "tiffany-loop-${tag}-x86_64-unknown-linux-gnu.tar.gz"
  "tiffany-loop-${tag}-aarch64-unknown-linux-gnu.tar.gz"
  "tiffany-loop-${tag}-x86_64-pc-windows-msvc.zip"
)
homebrew_assets=(
  "tiffany-loop-${tag}-aarch64-apple-darwin.tar.gz"
  "tiffany-loop-${tag}-x86_64-apple-darwin.tar.gz"
  "tiffany-loop-${tag}-x86_64-unknown-linux-gnu.tar.gz"
  "tiffany-loop-${tag}-aarch64-unknown-linux-gnu.tar.gz"
)
source_url="https://github.com/${release_repo}/archive/refs/tags/${tag}.tar.gz"
formula_ref="${tap_repo}/${formula_name}"
tap_name="$(homebrew_tap_name "$tap_repo")"

step() {
  printf '\n== %s ==\n' "$1"
}

assert_eq() {
  local label="$1"
  local expected="$2"
  local actual="$3"
  if [[ "$actual" != "$expected" ]]; then
    echo "$label mismatch" >&2
    echo "expected: $expected" >&2
    echo "actual:   $actual" >&2
    exit 1
  fi
}

assert_formula_contains() {
  local needle="$1"
  if ! grep -F -- "$needle" "$formula_path" >/dev/null; then
    echo "formula missing expected text: $needle" >&2
    print_tap_checkout_diagnostics "$tap_dir" "$tap_repo"
    exit 1
  fi
}

print_tap_checkout_diagnostics() {
  local tap_dir="$1"
  local tap_repo="$2"
  echo "tap checkout: $tap_dir" >&2
  if [[ ! -d "$tap_dir/.git" ]]; then
    echo "tap checkout is not a git repository" >&2
    echo "fix: brew untap $tap_repo && brew tap $tap_repo" >&2
    return
  fi

  local head upstream counts ahead behind dirty
  head="$(git -C "$tap_dir" rev-parse --short HEAD 2>/dev/null || true)"
  upstream="$(git -C "$tap_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  counts="$(git -C "$tap_dir" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null || true)"
  ahead="$(awk '{print $1}' <<<"$counts")"
  behind="$(awk '{print $2}' <<<"$counts")"
  dirty="$(git -C "$tap_dir" status --porcelain 2>/dev/null || true)"

  echo "tap git head: ${head:-unknown}" >&2
  echo "tap upstream: ${upstream:-none}" >&2
  if [[ -n "$counts" ]]; then
    echo "tap ahead/behind: ${ahead:-0}/${behind:-0}" >&2
  fi
  if [[ -n "$dirty" ]]; then
    echo "tap has local changes" >&2
  fi
  echo "fix: git -C \"$tap_dir\" fetch origin main && git -C \"$tap_dir\" reset --hard origin/main" >&2
  echo "or:  brew untap $tap_repo && brew tap $tap_repo" >&2
}

step "GitHub Release"
release_tag="$(gh release view "$tag" --repo "$release_repo" --json tagName --jq '.tagName')"
release_draft="$(gh release view "$tag" --repo "$release_repo" --json isDraft --jq '.isDraft')"
assert_eq "release tag" "$tag" "$release_tag"
assert_eq "release draft state" "false" "$release_draft"
declare -A asset_shas=()
for asset in "${assets[@]}"; do
  asset_digest="$(gh release view "$tag" --repo "$release_repo" --json assets --jq ".assets[] | select(.name == \"${asset}\") | .digest")"
  asset_size="$(gh release view "$tag" --repo "$release_repo" --json assets --jq ".assets[] | select(.name == \"${asset}\") | .size")"
  if [[ -z "$asset_digest" || "$asset_digest" == "null" || "$asset_digest" != sha256:* ]]; then
    echo "release asset not found or missing digest: $asset" >&2
    exit 1
  fi
  asset_shas["$asset"]="${asset_digest#sha256:}"
  echo "asset: $asset"
  echo "asset sha256: ${asset_shas[$asset]}"
  echo "asset size: $asset_size"
done

step "Homebrew tap formula"
if [[ -n "$tap_dir" ]]; then
  tap_dir="${tap_dir/#\~/$HOME}"
else
  brew update >/dev/null
  tap_dir="$(brew --repository "$tap_repo")"
fi
formula_path="$tap_dir/Formula/${formula_name}.rb"
if [[ ! -f "$formula_path" ]]; then
  echo "formula not found: $formula_path" >&2
  exit 1
fi

formula_text="$(cat "$formula_path")"
for asset in "${homebrew_assets[@]}"; do
  asset_url="https://github.com/${release_repo}/releases/download/${tag}/${asset}"
  if ! grep -F -- "$asset_url" "$formula_path" >/dev/null; then
    echo "formula does not reference expected asset URL: $asset_url" >&2
    print_tap_checkout_diagnostics "$tap_dir" "$tap_repo"
    exit 1
  fi
done
if ! grep -F -- "$source_url" "$formula_path" >/dev/null; then
  echo "formula does not reference expected source URL: $source_url" >&2
  print_tap_checkout_diagnostics "$tap_dir" "$tap_repo"
  exit 1
fi
assert_formula_contains "def caveats"
assert_formula_contains "version \"${version}\""
assert_formula_contains "Start Tiffany Loop with:"
assert_formula_contains "brew upgrade ${tap_name}/${formula_name}"
assert_formula_contains "brew untap ${tap_name}"
assert_formula_contains "brew tap ${tap_name}"
assert_formula_contains "brew reinstall ${tap_name}/${formula_name}"
assert_formula_contains "tiffany-loop is the primary command"
formula_sha_for_url() {
  local url="$1"
  printf '%s' "$formula_text" | awk -v url="$url" '
    $0 ~ "url \"" url "\"" { in_url = 1; next }
    in_url && $1 == "sha256" {
      gsub(/"/, "", $2)
      print $2
      exit
    }
  '
}
formula_source_sha="$(printf '%s' "$formula_text" | awk -v url="$source_url" '
  $0 ~ "url \"" url "\"" { in_url = 1; next }
  in_url && $1 == "sha256" {
    gsub(/"/, "", $2)
    print $2
    exit
  }
')"
for asset in "${homebrew_assets[@]}"; do
  asset_url="https://github.com/${release_repo}/releases/download/${tag}/${asset}"
  formula_asset_sha="$(formula_sha_for_url "$asset_url")"
  assert_eq "formula asset sha256 for $asset" "${asset_shas[$asset]}" "$formula_asset_sha"
done
source_sha="$(curl -fsSL "$source_url" | sha256_stream)"
assert_eq "formula source sha256" "$source_sha" "$formula_source_sha"
echo "formula: $formula_path"
echo "source sha256: $source_sha"

if [[ "$skip_install" == "true" ]]; then
  step "result"
  echo "post-release metadata checks passed for $tag"
  exit 0
fi

step "Homebrew install"
brew upgrade "$formula_ref"
installed_version="$(brew list --versions "$formula_ref" | awk '{print $2}' | tail -n 1)"
assert_eq "installed formula version" "$version" "$installed_version"

tiffany_version="$(tiffany-loop --version | awk '{print $2}')"
orchestrator_version="$(orchestrator --version | awk '{print $2}')"
alias_version="$(tiffany --version | awk '{print $2}')"
assert_eq "tiffany-loop version" "$version" "$tiffany_version"
assert_eq "orchestrator version" "$version" "$orchestrator_version"
assert_eq "tiffany alias version" "$version" "$alias_version"

tiffany-loop doctor >/tmp/tiffany-post-release-doctor.log
if ! grep -F -- "all required checks passed" /tmp/tiffany-post-release-doctor.log >/dev/null; then
  cat /tmp/tiffany-post-release-doctor.log >&2
  exit 1
fi
brew test "$formula_ref"

step "result"
echo "post-release checks passed for $tag"
