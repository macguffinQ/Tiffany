#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

tmp_root="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp_root"
}
trap cleanup EXIT

fake_cargo_home="$tmp_root/cargo-home"
mkdir -p "$fake_cargo_home/bin"
cat >"$fake_cargo_home/bin/cargo" <<'EOF'
#!/usr/bin/env bash
printf 'fake cargo from CARGO_HOME\n'
EOF
chmod +x "$fake_cargo_home/bin/cargo"

resolved="$(
  env -i \
    HOME="$tmp_root/home" \
    CARGO_HOME="$fake_cargo_home" \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/lib/tiffany-cargo.sh'; tiffany_resolve_cargo"
)"

if [[ "$resolved" != "$fake_cargo_home/bin/cargo" ]]; then
  echo "expected CARGO_HOME/bin cargo fallback" >&2
  echo "expected: $fake_cargo_home/bin/cargo" >&2
  echo "actual:   $resolved" >&2
  exit 1
fi

explicit="$(
  env -i \
    CARGO="$fake_cargo_home/bin/cargo" \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/lib/tiffany-cargo.sh'; tiffany_resolve_cargo"
)"

if [[ "$explicit" != "$fake_cargo_home/bin/cargo" ]]; then
  echo "expected explicit CARGO to win" >&2
  echo "expected: $fake_cargo_home/bin/cargo" >&2
  echo "actual:   $explicit" >&2
  exit 1
fi

echo "script helper checks passed"

tap_name_default="$(
  env -i \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/tiffany-update-homebrew-tap'; homebrew_tap_name macguffinQ/homebrew-tap"
)"

if [[ "$tap_name_default" != "macguffinQ/tap" ]]; then
  echo "expected default Homebrew tap name derivation" >&2
  echo "expected: macguffinQ/tap" >&2
  echo "actual:   $tap_name_default" >&2
  exit 1
fi

tap_name_custom="$(
  env -i \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/tiffany-update-homebrew-tap'; homebrew_tap_name example/homebrew-tools"
)"

if [[ "$tap_name_custom" != "example/tools" ]]; then
  echo "expected custom Homebrew tap name derivation" >&2
  echo "expected: example/tools" >&2
  echo "actual:   $tap_name_custom" >&2
  exit 1
fi

echo "tap name helper checks passed"

bash -n "$repo_dir/scripts/tiffany-check-legacy-tui-shims"
bash -n "$repo_dir/scripts/tiffany-slim-smoke"
bash -n "$repo_dir/scripts/tiffany-codex-tui-lib-test"
bash -n "$repo_dir/scripts/tiffany-build-time-gate"
"$repo_dir/scripts/tiffany-check-legacy-tui-shims" >/dev/null
"$repo_dir/scripts/tiffany-build-time-gate" --self-test >/dev/null
echo "legacy TUI shim helper checks passed"

tiffany_dev_help="$("$repo_dir/scripts/tiffany-dev" --help)"
for expected in \
  '/provider     configure provider credentials and endpoints' \
  '/role         register planner/critic/worker/reviewer roles' \
  '/roles        inspect current role -> provider -> model -> runtime wiring' \
  '/thread       inspect or clear stable worker sessions' \
  '/doctor       diagnose provider/model/key/runtime problems' \
  '/status       show current orchestration status' \
  '/help         show Tiffany command help' \
  '/copy         copy the last assistant answer' \
  '/raw          toggle copy-friendly raw scrollback mode' \
  '/diff         show git changes' \
  '/clear        clear the current chat surface' \
  '/exit         leave the UI'
do
  if ! grep -F -- "$expected" <<<"$tiffany_dev_help" >/dev/null; then
    echo "expected tiffany-dev --help to include TUI command help: $expected" >&2
    exit 1
  fi
done

for unsupported in /model /init /permissions /compact /review /resume /agent; do
  if grep -E "^[[:space:]]+${unsupported//\//\\/}[[:space:]]" <<<"$tiffany_dev_help" >/dev/null; then
    echo "expected tiffany-dev --help to hide unsupported Tiffany TUI command: $unsupported" >&2
    exit 1
  fi
done

echo "tiffany-dev help checks passed"

tiffany_dev_target="$tmp_root/tiffany-dev-target"
tiffany_dev_home="$tmp_root/tiffany-home"
tiffany_dev_cargo_log="$tmp_root/tiffany-dev-cargo.log"
expected_tiffany_version="$(
  awk '
    /^\[package\]/ { in_package = 1; next }
    /^\[/ && in_package { exit }
    in_package && $1 == "version" {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  ' "$repo_dir/Cargo.toml"
)"
fake_tiffany_cargo="$tmp_root/cargo-home/bin/tiffany-dev-cargo"
cat >"$fake_tiffany_cargo" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"$FAKE_TIFFANY_CARGO_LOG"

profile="debug"
prev=""
for arg in "$@"; do
  if [[ "$prev" == "--profile" ]]; then
    profile="$arg"
    break
  fi
  prev="$arg"
done
if [[ "$profile" == "dev" ]]; then
  profile="debug"
fi

bin_dir="${CARGO_TARGET_DIR:?}/$profile"
mkdir -p "$bin_dir"

make_fake_bin() {
  local name="$1"
  local path="$bin_dir/$name"
  cat >"$path" <<EOS
#!/usr/bin/env bash
if [[ "\${1:-}" == "--version" ]]; then
  echo "$name ${FAKE_TIFFANY_VERSION:?}"
  exit 0
fi
echo "$name fake \$*"
EOS
  chmod +x "$path"
}

prev=""
for arg in "$@"; do
  if [[ "$prev" == "--bin" ]]; then
    make_fake_bin "$arg"
  fi
  prev="$arg"
done
EOF
chmod +x "$fake_tiffany_cargo"

run_fake_tiffany_dev_status() {
  env \
    CARGO="$fake_tiffany_cargo" \
    CARGO_TARGET_DIR="$tiffany_dev_target" \
    TIFFANY_CARGO_TARGET_DIR="$tiffany_dev_target" \
    TIFFANY_HOME="$tiffany_dev_home" \
    TIFFANY_SQLITE_HOME="$tiffany_dev_home" \
    FAKE_TIFFANY_CARGO_LOG="$tiffany_dev_cargo_log" \
    FAKE_TIFFANY_VERSION="$expected_tiffany_version" \
    "$repo_dir/scripts/tiffany-dev" status >/dev/null
}

: >"$tiffany_dev_cargo_log"
run_fake_tiffany_dev_status
first_builds="$(wc -l <"$tiffany_dev_cargo_log" | tr -d ' ')"
if [[ "$first_builds" != "1" ]]; then
  echo "expected tiffany-dev to build the missing multi-call binary once" >&2
  echo "actual fake cargo invocations: $first_builds" >&2
  cat "$tiffany_dev_cargo_log" >&2
  exit 1
fi

: >"$tiffany_dev_cargo_log"
run_fake_tiffany_dev_status
second_builds="$(wc -l <"$tiffany_dev_cargo_log" | tr -d ' ')"
if [[ "$second_builds" != "0" ]]; then
  echo "expected tiffany-dev to reuse binaries when source stamp matches" >&2
  echo "actual fake cargo invocations: $second_builds" >&2
  cat "$tiffany_dev_cargo_log" >&2
  exit 1
fi

printf '%s\n' "stale stamp" >"$tiffany_dev_target/dev-small/orchestrator.tiffany-dev-stamp"
printf '%s\n' "stale stamp" >"$tiffany_dev_target/dev-small/tiffany-loop.tiffany-dev-stamp"
: >"$tiffany_dev_cargo_log"
run_fake_tiffany_dev_status
stale_builds="$(wc -l <"$tiffany_dev_cargo_log" | tr -d ' ')"
if [[ "$stale_builds" != "1" ]]; then
  echo "expected tiffany-dev to rebuild the multi-call binary once when source stamp is stale" >&2
  echo "actual fake cargo invocations: $stale_builds" >&2
  cat "$tiffany_dev_cargo_log" >&2
  exit 1
fi

echo "tiffany-dev source stamp checks passed"

clean_targets_repo="$tmp_root/clean-targets-repo"
mkdir -p \
  "$clean_targets_repo/scripts" \
  "$clean_targets_repo/target/debug/deps" \
  "$clean_targets_repo/target/debug/incremental" \
  "$clean_targets_repo/tiffany-ui/codex-rs/target/debug/deps" \
  "$clean_targets_repo/tiffany-ui/codex-rs/target/debug/incremental"
cp "$repo_dir/scripts/tiffany-clean-targets" "$clean_targets_repo/scripts/tiffany-clean-targets"
chmod +x "$clean_targets_repo/scripts/tiffany-clean-targets"
printf '%s\n' keep >"$clean_targets_repo/target/debug/deps/shared.keep"
printf '%s\n' cache >"$clean_targets_repo/target/debug/incremental/cache.bin"
printf '%s\n' keep >"$clean_targets_repo/tiffany-ui/codex-rs/target/debug/deps/legacy.keep"
printf '%s\n' cache >"$clean_targets_repo/tiffany-ui/codex-rs/target/debug/incremental/cache.bin"

dry_run_output="$("$clean_targets_repo/scripts/tiffany-clean-targets" --dry-run --trim)"
if ! grep -F -- "would remove shared debug incremental cache" <<<"$dry_run_output" >/dev/null; then
  echo "expected dry-run trim to preview shared incremental cleanup" >&2
  echo "$dry_run_output" >&2
  exit 1
fi
if [[ ! -e "$clean_targets_repo/target/debug/incremental/cache.bin" ]]; then
  echo "dry-run trim must not delete shared incremental cache" >&2
  exit 1
fi

"$clean_targets_repo/scripts/tiffany-clean-targets" --trim >/dev/null
if [[ -e "$clean_targets_repo/target/debug/incremental" ]]; then
  echo "expected trim to remove shared incremental cache" >&2
  exit 1
fi
if [[ ! -e "$clean_targets_repo/target/debug/deps/shared.keep" ]]; then
  echo "trim must keep compiled shared deps" >&2
  exit 1
fi
if [[ ! -e "$clean_targets_repo/tiffany-ui/codex-rs/target/debug/deps/legacy.keep" ]]; then
  echo "trim must keep compiled legacy deps" >&2
  exit 1
fi

"$clean_targets_repo/scripts/tiffany-clean-targets" >/dev/null
if [[ -e "$clean_targets_repo/tiffany-ui/codex-rs/target" ]]; then
  echo "default clean-targets mode should remove only the legacy fork-local target" >&2
  exit 1
fi
if [[ ! -e "$clean_targets_repo/target/debug/deps/shared.keep" ]]; then
  echo "default clean-targets mode must keep shared target artifacts" >&2
  exit 1
fi

echo "tiffany-clean-targets safety checks passed"

release_workflow="$repo_dir/.github/workflows/release.yml"
if ! grep -F -- './scripts/tiffany-post-release-check --tag ${GITHUB_REF_NAME} --tap-dir ../homebrew-tap --skip-install' "$release_workflow" >/dev/null; then
  echo "expected release workflow manual tap instructions to use --tap-dir" >&2
  exit 1
fi

echo "release workflow helper checks passed"
