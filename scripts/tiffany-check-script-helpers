#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

tmp_root="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp_root"
}
trap cleanup EXIT

fake_cargo_home="$tmp_root/cargo-home"
mkdir -p "$fake_cargo_home/bin"
cat >"$fake_cargo_home/bin/cargo" <<'EOF'
#!/usr/bin/env bash
printf 'fake cargo from CARGO_HOME\n'
EOF
chmod +x "$fake_cargo_home/bin/cargo"

resolved="$(
  env -i \
    HOME="$tmp_root/home" \
    CARGO_HOME="$fake_cargo_home" \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/lib/tiffany-cargo.sh'; tiffany_resolve_cargo"
)"

if [[ "$resolved" != "$fake_cargo_home/bin/cargo" ]]; then
  echo "expected CARGO_HOME/bin cargo fallback" >&2
  echo "expected: $fake_cargo_home/bin/cargo" >&2
  echo "actual:   $resolved" >&2
  exit 1
fi

explicit="$(
  env -i \
    CARGO="$fake_cargo_home/bin/cargo" \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/lib/tiffany-cargo.sh'; tiffany_resolve_cargo"
)"

if [[ "$explicit" != "$fake_cargo_home/bin/cargo" ]]; then
  echo "expected explicit CARGO to win" >&2
  echo "expected: $fake_cargo_home/bin/cargo" >&2
  echo "actual:   $explicit" >&2
  exit 1
fi

echo "script helper checks passed"

tap_name_default="$(
  env -i \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/tiffany-update-homebrew-tap'; homebrew_tap_name macguffinQ/homebrew-tap"
)"

if [[ "$tap_name_default" != "macguffinQ/tap" ]]; then
  echo "expected default Homebrew tap name derivation" >&2
  echo "expected: macguffinQ/tap" >&2
  echo "actual:   $tap_name_default" >&2
  exit 1
fi

tap_name_custom="$(
  env -i \
    PATH="/usr/bin:/bin" \
    bash -c "source '$repo_dir/scripts/tiffany-update-homebrew-tap'; homebrew_tap_name example/homebrew-tools"
)"

if [[ "$tap_name_custom" != "example/tools" ]]; then
  echo "expected custom Homebrew tap name derivation" >&2
  echo "expected: example/tools" >&2
  echo "actual:   $tap_name_custom" >&2
  exit 1
fi

echo "tap name helper checks passed"

tiffany_dev_help="$("$repo_dir/scripts/tiffany-dev" --help)"
for expected in \
  '/provider     configure provider credentials and endpoints' \
  '/role         register planner/critic/worker/reviewer roles' \
  '/roles        inspect current role -> provider -> model -> runtime wiring' \
  '/thread       inspect or clear stable worker sessions' \
  '/doctor       diagnose provider/model/key/runtime problems' \
  '/status       show current orchestration status' \
  '/copy         copy the last assistant answer' \
  '/raw          toggle copy-friendly raw scrollback mode' \
  '/diff         show git changes' \
  '/clear        clear the current chat surface' \
  '/exit         leave the UI'
do
  if ! grep -F -- "$expected" <<<"$tiffany_dev_help" >/dev/null; then
    echo "expected tiffany-dev --help to include TUI command help: $expected" >&2
    exit 1
  fi
done

for unsupported in /model /init /permissions /compact /review /resume /agent; do
  if grep -E "^[[:space:]]+${unsupported//\//\\/}[[:space:]]" <<<"$tiffany_dev_help" >/dev/null; then
    echo "expected tiffany-dev --help to hide unsupported Tiffany TUI command: $unsupported" >&2
    exit 1
  fi
done

echo "tiffany-dev help checks passed"

release_workflow="$repo_dir/.github/workflows/release.yml"
if ! grep -F -- './scripts/tiffany-post-release-check --tag ${GITHUB_REF_NAME} --tap-dir ../homebrew-tap --skip-install' "$release_workflow" >/dev/null; then
  echo "expected release workflow manual tap instructions to use --tap-dir" >&2
  exit 1
fi

echo "release workflow helper checks passed"
