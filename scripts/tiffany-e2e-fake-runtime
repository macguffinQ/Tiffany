#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_dir/scripts/lib/tiffany-binaries.sh"

usage() {
  cat <<'EOF'
Usage: ./scripts/tiffany-e2e-fake-runtime [--bin-dir DIR]

Runs a no-network Tiffany orchestration e2e using a fake Claude Code CLI.
It verifies:
  - orchestrator events can execute the production Claude worker adapter path
  - planner/critic/reviewer subprocess roles can parse CLI JSON
  - worker output reaches the visible event stream without raw JSON leakage
  - worker file changes produce visible diff events and session records
  - persisted TUI jobs record status and final result summaries
  - TUI retry handoff exposes the full prompt without creating a duplicate queued job
  - worker thread/native session state is persisted and inspectable
  - a second same-role worker run resumes the saved native session
  - session logs can be listed and shown after the run

Default binaries: ./target/dev-small/orchestrator, or ./target/dev-small/tiffany-loop with an auto-created alias
EOF
}

target_dir="${TIFFANY_CARGO_TARGET_DIR:-${CARGO_TARGET_DIR:-$repo_dir/target}}"
case "$target_dir" in
  /*) ;;
  *) target_dir="$repo_dir/$target_dir" ;;
esac

bin_dir="$target_dir/dev-small"
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --bin-dir)
      if [[ -z "${2:-}" ]]; then
        usage >&2
        exit 2
      fi
      bin_dir="$2"
      shift
      ;;
    --bin-dir=*)
      bin_dir="${1#--bin-dir=}"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

case "$bin_dir" in
  /*) ;;
  *) bin_dir="$repo_dir/$bin_dir" ;;
esac

tmp_root="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp_root"
}
trap cleanup EXIT

orchestrator_bin="$(tiffany_runtime_alias_from_bin_dir "$bin_dir" "$tmp_root/bin")"
fake_claude="$repo_dir/scripts/tests/fake-claude-code"
if [[ ! -x "$fake_claude" ]]; then
  echo "missing executable: $fake_claude" >&2
  exit 1
fi

export HOME="$tmp_root/home"
export TIFFANY_HOME="$tmp_root/tiffany"
export TIFFANY_SQLITE_HOME="$tmp_root/tiffany-sqlite"
export CODEX_HOME="$TIFFANY_HOME"
export CODEX_SQLITE_HOME="$TIFFANY_SQLITE_HOME"
export TIFFANY_FAKE_CLAUDE_LOG="$tmp_root/fake-claude.log"
export TIFFANY_FAKE_CLAUDE_WRITE_DIFF=1
mkdir -p "$HOME" "$TIFFANY_HOME" "$TIFFANY_SQLITE_HOME"

workdir="$tmp_root/project"
mkdir -p "$workdir"
git -C "$workdir" init -q
git -C "$workdir" config user.name "Tiffany Smoke"
git -C "$workdir" config user.email "smoke@example.invalid"
printf 'smoke\n' > "$workdir/README.md"
git -C "$workdir" add README.md
git -C "$workdir" commit -qm "initial"

config="$tmp_root/config.yaml"
cat > "$config" <<EOF
providers:
  fake:
    type: anthropic
    api_key: fake-key
runtimes:
  claude-code:
    type: subprocess
    binary: $fake_claude
    supports_agent_teams: true
models:
  - id: fake-claude
    provider: fake
    name: fake-claude
roles:
  planner:
    model: fake-claude
    runtime: claude-code
    agent_teams: false
  critic:
    model: fake-claude
    runtime: claude-code
    agent_teams: false
  reviewer:
    model: fake-claude
    runtime: claude-code
    agent_teams: false
  worker-cc:
    model: fake-claude
    runtime: claude-code
    agent_teams: false
behavior:
  worktree_base: $tmp_root/worktrees
  db_path: $tmp_root/state.db
  session_log_dir: $tmp_root/sessions
  enable_critic: true
  enable_reviewer: true
  max_replan: 1
  mux: none
  cc_bypass_permissions: true
EOF

run_log() {
  local label="$1"
  shift
  local log="$tmp_root/$label.log"
  echo "checking $label..." >&2
  if ! (cd "$workdir" && "$@" >"$log" 2>&1); then
    cat "$log" >&2
    exit 1
  fi
  printf '%s\n' "$log"
}

assert_contains() {
  local file="$1"
  local needle="$2"
  if ! grep -F -- "$needle" "$file" >/dev/null; then
    echo "expected $file to contain: $needle" >&2
    echo "---- $file ----" >&2
    cat "$file" >&2
    exit 1
  fi
}

assert_not_contains() {
  local file="$1"
  local needle="$2"
  if grep -F -- "$needle" "$file" >/dev/null; then
    echo "expected $file not to contain: $needle" >&2
    echo "---- $file ----" >&2
    cat "$file" >&2
    exit 1
  fi
}

events_log="$(run_log events "$orchestrator_bin" --config "$config" events "Improve the fake runtime smoke flow" --format text --worker worker-cc)"
assert_contains "$events_log" "route    full-pipeline"
assert_contains "$events_log" "plan ready"
assert_contains "$events_log" "worker-cc"
assert_contains "$events_log" "Fake Claude worker completed the Tiffany e2e smoke run"
assert_contains "$events_log" "diff"
assert_contains "$events_log" "files changed"
assert_contains "$events_log" "README.md"
assert_contains "$events_log" "reviewer passed"
assert_not_contains "$events_log" "done - 0 worker run"

resume_events_log="$(run_log events-resume "$orchestrator_bin" --config "$config" events "Improve the fake runtime smoke flow again" --format text --worker worker-cc)"
assert_contains "$resume_events_log" "route    full-pipeline"
assert_contains "$resume_events_log" "worker-cc"
assert_contains "$resume_events_log" "Fake Claude worker completed the Tiffany e2e smoke run"
assert_contains "$resume_events_log" "reviewer passed"
assert_contains "$resume_events_log" "native fake-claude-native-session"
assert_not_contains "$resume_events_log" "done - 0 worker run"

jobs_log="$(run_log jobs "$orchestrator_bin" --config "$config" jobs --limit 5)"
assert_contains "$jobs_log" "Jobs"
assert_contains "$jobs_log" "done"
assert_contains "$jobs_log" "role worker-cc"
assert_contains "$jobs_log" "session "
assert_contains "$jobs_log" "native fake-claude-native-session"
assert_contains "$jobs_log" "result Fake Claude worker completed the Tiffany e2e smoke run"
assert_not_contains "$jobs_log" "{"
assert_not_contains "$jobs_log" "\"result\""

retry_handoff_log="$(run_log jobs-retry-handoff "$orchestrator_bin" --config "$config" jobs retry last --tui-handoff)"
assert_contains "$retry_handoff_log" "prepared for TUI retry"
assert_contains "$retry_handoff_log" "queued in current TUI input queue"
assert_contains "$retry_handoff_log" "retry prompt:"
assert_contains "$retry_handoff_log" "/queue run"
assert_not_contains "$retry_handoff_log" "queued for retry as"

jobs_after_handoff_log="$(run_log jobs-after-retry-handoff "$orchestrator_bin" --config "$config" jobs --limit 5)"
assert_contains "$jobs_after_handoff_log" "queued: 0"

thread_log="$(run_log thread-show "$orchestrator_bin" --config "$config" thread show worker-cc)"
assert_contains "$thread_log" "Session card"
assert_contains "$thread_log" "role: worker-cc"
assert_contains "$thread_log" "native session: fake-claude-native-session"
assert_contains "$thread_log" "native resume: "
assert_contains "$thread_log" "native handoff: "
assert_contains "$thread_log" "--resume fake-claude-native-session"
assert_contains "$thread_log" "TUI resume: /continue open worker-cc"

sessions_log="$(run_log sessions-list "$orchestrator_bin" --config "$config" sessions list --limit 10)"
assert_contains "$sessions_log" "claude-code"
assert_contains "$sessions_log" "worker"

session_show_log="$(run_log sessions-show "$orchestrator_bin" --config "$config" sessions show last --tail 20)"
assert_contains "$session_show_log" "Fake Claude worker completed the Tiffany e2e smoke run"
assert_contains "$session_show_log" "files: README.md"
assert_contains "$session_show_log" "native session: fake-claude-native-session"

native_history_log="$(run_log native-history-worker "$orchestrator_bin" --config "$config" sessions native-history --format text --role worker-cc)"
assert_contains "$native_history_log" "Native history"
assert_contains "$native_history_log" "filter: role=worker-cc"
assert_contains "$native_history_log" "worker-cc"
assert_contains "$native_history_log" "native: fake-claude-native-session"
assert_contains "$native_history_log" "Fake Claude worker completed the Tiffany e2e smoke run"
assert_contains "$native_history_log" "tiffany-loop /continue open worker-cc"
assert_not_contains "$native_history_log" "\"result\""

native_history_native_log="$(run_log native-history-native "$orchestrator_bin" --config "$config" sessions native-history --format text --native fake-claude-native-session)"
assert_contains "$native_history_native_log" "filter: native=fake-claude-native-session"
assert_contains "$native_history_native_log" "worker-cc"
assert_contains "$native_history_native_log" "Fake Claude worker completed the Tiffany e2e smoke run"

thread_export="$tmp_root/worker-cc-thread.md"
thread_export_log="$(run_log thread-export "$orchestrator_bin" --config "$config" thread export worker-cc --out "$thread_export")"
assert_contains "$thread_export_log" "Worker thread session exported"
assert_contains "$thread_export_log" "role: worker-cc"
assert_contains "$thread_export_log" "target: $thread_export"
assert_contains "$thread_export" "Fake Claude worker completed the Tiffany e2e smoke run"
assert_contains "$thread_export" "native session: fake-claude-native-session"
assert_contains "$thread_export" "README.md"

failure_log="$tmp_root/worker-failure.log"
echo "checking worker-failure..." >&2
if (cd "$workdir" && TIFFANY_FAKE_CLAUDE_FAIL_WORKER=1 "$orchestrator_bin" --config "$config" events "Exercise the fake worker failure path" --format text --worker worker-cc >"$failure_log" 2>&1); then
  echo "expected fake worker failure command to fail" >&2
  cat "$failure_log" >&2
  exit 1
fi
assert_contains "$failure_log" "worker-cc"
assert_contains "$failure_log" "Fake Claude worker failed intentionally for Tiffany e2e"
assert_contains "$failure_log" "worker   worker-cc failed"
assert_contains "$failure_log" "✗ error"
assert_contains "$failure_log" "1 worker task(s) failed"
assert_not_contains "$failure_log" "done - 0 worker run"
assert_not_contains "$failure_log" "done     0 worker run(s) completed"

assert_contains "$TIFFANY_FAKE_CLAUDE_LOG" "--add-dir"
assert_contains "$TIFFANY_FAKE_CLAUDE_LOG" "--append-system-prompt"
python3 - "$TIFFANY_FAKE_CLAUDE_LOG" <<'PY'
import json
import sys

path = sys.argv[1]
worker_calls = []
with open(path, "r", encoding="utf-8") as handle:
    for line in handle:
        record = json.loads(line)
        prompt = record.get("prompt", "")
        if (
            "Decompose into 1-5 sub-tasks" in prompt
            or "Re-plan" in prompt
            or ("Critique it" in prompt and "Proposed plan" in prompt)
            or "Review against the user's intent" in prompt
        ):
            continue
        worker_calls.append(record.get("args", []))

if len(worker_calls) != 3:
    raise SystemExit(f"expected 3 fake worker calls, saw {len(worker_calls)}")

first, second, failing = worker_calls
if "--resume" in first:
    raise SystemExit(f"first worker call unexpectedly used --resume: {first!r}")

expected = ["--resume", "fake-claude-native-session"]
if not any(second[i : i + 2] == expected for i in range(len(second) - 1)):
    raise SystemExit(f"second worker call did not resume fake native session: {second!r}")
if not any(failing[i : i + 2] == expected for i in range(len(failing) - 1)):
    raise SystemExit(f"failing worker call did not reuse fake native session: {failing!r}")
PY

echo "fake runtime e2e passed: $orchestrator_bin"
