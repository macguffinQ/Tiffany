#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_dir/scripts/lib/tiffany-cargo.sh"

usage() {
  cat <<'EOF'
Usage: ./scripts/tiffany-check [--smoke|--dist]

Checks the local tiffany-loop fork, install surface, orchestrator bridge, and checked-in examples.

Modes:
  --smoke  Small debug build plus bridge/event/example smoke checks. Intended for PR/main CI.
  --dist   tiffany-dist profile build plus the same checks. Intended before release.

Default: --dist
EOF
}

mode="dist"
case "${1:-}" in
  ""|--dist|--fast-release)
    mode="dist"
    ;;
  --smoke|--debug)
    mode="smoke"
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

cargo_bin="$(tiffany_resolve_cargo)"

target_dir="${TIFFANY_CARGO_TARGET_DIR:-${CARGO_TARGET_DIR:-$repo_dir/target}}"
case "$target_dir" in
  /*) ;;
  *) target_dir="$repo_dir/$target_dir" ;;
esac
export CARGO_TARGET_DIR="$target_dir"

case "$mode" in
  smoke)
    build_args=(--small --locked)
    binary_dir="$target_dir/dev-small"
    ;;
  dist)
    build_args=(--fast-release --locked)
    binary_dir="$target_dir/tiffany-dist"
    ;;
esac

TIFFANY_QUIET=1 "$repo_dir/scripts/tiffany-build" "${build_args[@]}"

echo "checking tiffany-loop fork format..."
fmt_log="$(mktemp)"
if ! (cd "$repo_dir/tiffany-ui/codex-rs" && "$cargo_bin" fmt -- --check 2>"$fmt_log"); then
  cat "$fmt_log" >&2
  rm -f "$fmt_log"
  exit 1
fi
grep -v "imports_granularity = Item" "$fmt_log" >&2 || true
rm -f "$fmt_log"

echo "checking shared event formatter..."
"$cargo_bin" fmt --manifest-path "$repo_dir/crates/tiffany-event-format/Cargo.toml" -- --check
"$cargo_bin" test --manifest-path "$repo_dir/crates/tiffany-event-format/Cargo.toml" >/dev/null

echo "checking smoke helper scripts..."
bash -n "$repo_dir/scripts/tiffany-e2e-fake-runtime"
bash -n "$repo_dir/scripts/tiffany-e2e-multi-runtime"
bash -n "$repo_dir/scripts/tiffany-real-runtime-check"
bash -n "$repo_dir/scripts/tiffany-check-legacy-tui-shims"
"$repo_dir/scripts/tiffany-check-legacy-tui-shims" >/dev/null
"$repo_dir/scripts/tiffany-real-runtime-check" --self-test >/dev/null
python3 - \
  "$repo_dir/scripts/tests/fake-claude-code" \
  "$repo_dir/scripts/tests/fake-codex" \
  "$repo_dir/scripts/tests/fake-gemini" <<'PY'
import pathlib
import sys

for name in sys.argv[1:]:
    path = pathlib.Path(name)
    compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY

echo "checking tiffany-loop CLI help..."
"$repo_dir/scripts/tiffany-dev" --help >/dev/null 2>&1
if [[ "$mode" == "smoke" ]]; then
  "$repo_dir/scripts/tiffany-dev" -- --help >/dev/null 2>&1
fi

echo "checking isolated install surface..."
"$repo_dir/scripts/tiffany-install-smoke" "--$mode" --bin-dir "$binary_dir"

echo "checking orchestrator bridge..."
"$binary_dir/tiffany-loop" orchestrator \
  --bin "$binary_dir/orchestrator" \
  --legacy help >/dev/null 2>&1

echo "checking orchestrator event stream..."
"$binary_dir/orchestrator" events --help >/dev/null 2>&1

echo "checking fake runtime orchestration e2e..."
"$repo_dir/scripts/tiffany-e2e-fake-runtime" --bin-dir "$binary_dir"

echo "checking multi-runtime worker e2e..."
"$repo_dir/scripts/tiffany-e2e-multi-runtime" --bin-dir "$binary_dir"

echo "checking real-runtime adapter harness..."
TIFFANY_ORCHESTRATOR_BIN="$binary_dir/orchestrator" \
TIFFANY_REAL_CLAUDE_BIN="$repo_dir/scripts/tests/fake-claude-code" \
TIFFANY_REAL_CODEX_BIN="$repo_dir/scripts/tests/fake-codex" \
TIFFANY_REAL_GEMINI_BIN="$repo_dir/scripts/tests/fake-gemini" \
  "$repo_dir/scripts/tiffany-real-runtime-check" --adapter-run --runtime all >/dev/null

"$repo_dir/scripts/tiffany-check-examples"

echo "check passed"
