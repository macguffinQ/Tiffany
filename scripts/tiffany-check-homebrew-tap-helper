#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

tmp_root="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp_root"
}
trap cleanup EXIT

fake_bin="$tmp_root/bin"
mkdir -p "$fake_bin"

cat > "$fake_bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ge 3 && "$1" == "release" && "$2" == "view" ]]; then
  printf 'sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n'
  exit 0
fi

echo "unexpected fake gh invocation: $*" >&2
exit 2
EOF
chmod +x "$fake_bin/gh"

cat > "$fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ge 1 && "${*: -1}" == "https://github.com/example/tiffany-loop/archive/refs/tags/v9.8.7.tar.gz" ]]; then
  printf 'source archive bytes for tiffany-loop test\n'
  exit 0
fi

echo "unexpected fake curl invocation: $*" >&2
exit 2
EOF
chmod +x "$fake_bin/curl"

formula="$tmp_root/tiffany-loop.rb"
PATH="$fake_bin:$PATH" "$repo_dir/scripts/tiffany-update-homebrew-tap" \
  --tag v9.8.7 \
  --repo example/tiffany-loop \
  --tap-repo example/homebrew-tools \
  --dry-run > "$formula"

source_sha="$(printf 'source archive bytes for tiffany-loop test\n' | {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    shasum -a 256 | awk '{print $1}'
  fi
})"

assert_contains() {
  local needle="$1"
  if ! grep -F -- "$needle" "$formula" >/dev/null; then
    echo "expected generated formula to contain: $needle" >&2
    echo "---- formula ----" >&2
    cat "$formula" >&2
    exit 1
  fi
}

assert_contains 'homepage "https://github.com/example/tiffany-loop"'
assert_contains 'url "https://github.com/example/tiffany-loop/releases/download/v9.8.7/tiffany-loop-v9.8.7-aarch64-apple-darwin.tar.gz"'
assert_contains 'sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"'
assert_contains 'url "https://github.com/example/tiffany-loop/archive/refs/tags/v9.8.7.tar.gz"'
assert_contains "sha256 \"${source_sha}\""
assert_contains 'bin.install "orchestrator", "tiffany-loop", "tiffany"'
assert_contains 'system "cargo", "install", *std_cargo_args, "--profile", "tiffany-dist"'
assert_contains 'system "cargo", "install", *std_cargo_args(path: "tiffany-ui/codex-rs/tiffany-cli"), "--profile", "tiffany-dist"'
assert_contains 'system "strip", bin/"orchestrator", bin/"tiffany-loop", bin/"tiffany" if OS.mac? || OS.linux?'
assert_contains 'def caveats'
assert_contains 'brew untap example/tools'
assert_contains 'brew tap example/tools'
assert_contains 'brew reinstall example/tools/tiffany-loop'
assert_contains 'tiffany-loop is the primary command'
assert_contains 'assert_match "orchestrator", shell_output("#{bin}/orchestrator --help")'
assert_contains 'assert_match "orchestrator", shell_output("#{bin}/tiffany-loop orchestrator --help 2>/dev/null")'
assert_contains 'assert_match "orchestrator status", shell_output("#{bin}/tiffany-loop status --help 2>/dev/null")'

if command -v ruby >/dev/null 2>&1; then
  ruby -c "$formula" >/dev/null
fi

echo "homebrew tap helper check passed"

tap_checkout="$tmp_root/homebrew-tools"
mkdir -p "$tap_checkout/Formula"
cp "$formula" "$tap_checkout/Formula/tiffany-loop.rb"

cat > "$fake_bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ge 3 && "$1" == "release" && "$2" == "view" ]]; then
  case "$*" in
    *"--json tagName --jq .tagName"*)
      printf 'v9.8.7\n'
      ;;
    *"--json isDraft --jq .isDraft"*)
      printf 'false\n'
      ;;
    *"--json assets --jq"*".digest"*)
      printf 'sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n'
      ;;
    *"--json assets --jq"*".size"*)
      printf '12345\n'
      ;;
    *)
      echo "unexpected fake gh invocation: $*" >&2
      exit 2
      ;;
  esac
  exit 0
fi

echo "unexpected fake gh invocation: $*" >&2
exit 2
EOF
chmod +x "$fake_bin/gh"

PATH="$fake_bin:$PATH" "$repo_dir/scripts/tiffany-post-release-check" \
  --tag v9.8.7 \
  --repo example/tiffany-loop \
  --tap example/tools \
  --tap-dir "$tap_checkout" \
  --skip-install > "$tmp_root/post-release.log"

if ! grep -F -- "post-release metadata checks passed for v9.8.7" "$tmp_root/post-release.log" >/dev/null; then
  echo "expected post-release metadata check to pass" >&2
  cat "$tmp_root/post-release.log" >&2
  exit 1
fi

echo "post-release tap-dir helper check passed"
