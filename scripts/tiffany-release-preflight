#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_dir/scripts/lib/tiffany-cargo.sh"

usage() {
  cat <<'EOF'
Usage: ./scripts/tiffany-release-preflight [--quick|--full] [--tag vX.Y.Z]

Runs the release preflight checks from this checkout.

Modes:
  --quick  Format, clippy, tests, Tiffany UI targeted tests, examples, locked build, formula syntax, and open-source audit.
           When --tag is present, also runs the serial full codex-tui lib gate.
  --full   Quick checks plus the serial full codex-tui lib gate and Tiffany dist packaging checks for release tags.

Options:
  --tag    Verify the tag version matches the root Cargo.toml package version.
           Tagged release checks also enforce a 24-hour cooldown after the
           previous release tag. Use TIFFANY_RELEASE_ALLOW_FREQUENT=1 only for
           urgent installer, startup, or security fixes.

Default: --quick
EOF
}

mode="quick"
release_tag=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --quick)
      mode="quick"
      ;;
    --full|--dist|--release)
      mode="full"
      ;;
    --tag)
      if [[ -z "${2:-}" ]]; then
        usage >&2
        exit 2
      fi
      release_tag="$2"
      shift
      ;;
    --tag=*)
      release_tag="${1#--tag=}"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

cargo_bin="$(tiffany_resolve_cargo)"

tiffany_fork_cargo_bin="${TIFFANY_FORK_CARGO:-}"
if [[ -z "$tiffany_fork_cargo_bin" ]]; then
  if "$cargo_bin" +1.95.0 --version >/dev/null 2>&1; then
    tiffany_fork_cargo_bin="$cargo_bin +1.95.0"
  else
    tiffany_fork_cargo_bin="$cargo_bin"
  fi
fi

tiffany_fork_cargo() {
  # shellcheck disable=SC2086
  $tiffany_fork_cargo_bin "$@"
}

target_dir="${TIFFANY_CARGO_TARGET_DIR:-${CARGO_TARGET_DIR:-$repo_dir/target}}"
case "$target_dir" in
  /*) ;;
  *) target_dir="$repo_dir/$target_dir" ;;
esac
export CARGO_TARGET_DIR="$target_dir"

step() {
  printf '\n== %s ==\n' "$1"
}

root_package_version() {
  awk '
    /^\[package\]/ { in_package = 1; next }
    /^\[/ && in_package { exit }
    in_package && $1 == "version" {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  ' "$repo_dir/Cargo.toml"
}

package_version_at() {
  local manifest="$1"
  awk '
    /^\[package\]/ { in_package = 1; next }
    /^\[/ && in_package { exit }
    in_package && $1 == "version" {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  ' "$manifest"
}

check_release_version_sync() {
  local expected="$1"
  local manifest version
  for manifest in \
    "$repo_dir/tiffany-ui/codex-rs/tiffany-cli/Cargo.toml" \
    "$repo_dir/tiffany-ui/codex-rs/tui/Cargo.toml"
  do
    version="$(package_version_at "$manifest")"
    if [[ "$version" != "$expected" ]]; then
      echo "Release version mismatch in ${manifest#$repo_dir/}" >&2
      echo "expected: $expected" >&2
      echo "actual:   ${version:-<missing>}" >&2
      exit 1
    fi
  done
  echo "root, tiffany-cli, and codex-tui versions match $expected"
}

check_changelog_release_entry() {
  local expected="$1"
  local changelog="$repo_dir/CHANGELOG.md"
  if [[ ! -f "$changelog" ]]; then
    echo "Missing CHANGELOG.md" >&2
    exit 1
  fi
  if ! grep -Eq "^## \\[${expected//./\\.}\\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" "$changelog"; then
    echo "CHANGELOG.md is missing a release entry for $expected" >&2
    echo "Add a section like: ## [$expected] - YYYY-MM-DD" >&2
    exit 1
  fi
  echo "CHANGELOG.md contains release entry for $expected"
}

previous_release_tag() {
  local current_tag="$1"
  git -C "$repo_dir" tag --list 'v[0-9]*' --sort=-v:refname | while read -r tag; do
    if [[ "$tag" != "$current_tag" ]]; then
      printf '%s\n' "$tag"
      break
    fi
  done
}

git_tag_timestamp() {
  local tag="$1"
  local timestamp
  timestamp="$(git -C "$repo_dir" log -1 --format=%ct "$tag" 2>/dev/null || true)"
  [[ "$timestamp" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$timestamp"
}

if [[ -n "$release_tag" ]]; then
  step "release tag version"
  package_version="$(root_package_version)"
  tag_version="${release_tag#v}"
  if [[ -z "$package_version" ]]; then
    echo "Could not read root package version from Cargo.toml" >&2
    exit 1
  fi
  if [[ "$tag_version" != "$package_version" ]]; then
    echo "Tag $release_tag does not match Cargo.toml package version $package_version" >&2
    exit 1
  fi
  echo "tag $release_tag matches package version $package_version"
  check_release_version_sync "$package_version"
  check_changelog_release_entry "$package_version"

  if [[ "${TIFFANY_RELEASE_ALLOW_FREQUENT:-}" != "1" ]]; then
    previous_tag="$(previous_release_tag "$release_tag")"
    if [[ -n "$previous_tag" ]]; then
      previous_timestamp="$(git_tag_timestamp "$previous_tag" || true)"
      if [[ -n "$previous_timestamp" ]]; then
        now_timestamp="$(date +%s)"
        release_age_seconds=$((now_timestamp - previous_timestamp))
        if (( release_age_seconds < 86400 )); then
          echo "Previous release tag $previous_tag is less than 24 hours old." >&2
          echo "Batch small fixes under CHANGELOG.md Unreleased; only override for urgent release blockers." >&2
          echo "Set TIFFANY_RELEASE_ALLOW_FREQUENT=1 to bypass this guard." >&2
          exit 1
        fi
      fi
    fi
  fi
fi

step "root format"
(cd "$repo_dir" && "$cargo_bin" fmt -- --check)

step "shared event formatter format"
"$cargo_bin" fmt --manifest-path "$repo_dir/crates/tiffany-event-format/Cargo.toml" -- --check

step "root clippy"
(cd "$repo_dir" && "$cargo_bin" clippy --all-targets -- -D warnings)

step "root tests"
(cd "$repo_dir" && "$cargo_bin" test --all)

step "shared event formatter tests"
"$cargo_bin" test --manifest-path "$repo_dir/crates/tiffany-event-format/Cargo.toml"

step "example tests"
"$repo_dir/scripts/tiffany-check-examples"

step "locked root build"
(cd "$repo_dir" && "$cargo_bin" build --locked)

step "open-source audit"
"$repo_dir/scripts/open-source-audit"

formula_template="$repo_dir/packaging/homebrew/tiffany-loop.rb"
if [[ -f "$formula_template" ]]; then
  step "homebrew formula template"
  if command -v ruby >/dev/null 2>&1; then
    ruby -c "$formula_template"
  else
    echo "ruby unavailable; skipped formula syntax check"
  fi
fi

step "homebrew tap helper"
"$repo_dir/scripts/tiffany-check-homebrew-tap-helper"

step "release target matrix"
"$repo_dir/scripts/tiffany-release-targets" --check

step "release build-time gate self-test"
"$repo_dir/scripts/tiffany-build-time-gate" --self-test

step "script helpers"
"$repo_dir/scripts/tiffany-check-script-helpers"

step "tiffany slim runtime smoke"
"$repo_dir/scripts/tiffany-slim-smoke" --quiet

step "tiffany fork targeted format"
(cd "$repo_dir/tiffany-ui/codex-rs" && tiffany_fork_cargo fmt -p codex-tui -p tiffany-cli -- --check)

step "tiffany-loop orchestrator targeted tests"
(cd "$repo_dir/tiffany-ui/codex-rs" && tiffany_fork_cargo test -p codex-tui tiffany_orchestrator)

step "tiffany slash command targeted tests"
(cd "$repo_dir/tiffany-ui/codex-rs" && tiffany_fork_cargo test -p codex-tui slash_commands)

step "tiffany update action targeted tests"
(cd "$repo_dir/tiffany-ui/codex-rs" && tiffany_fork_cargo test -p codex-tui update_action)

step "tiffany runtime update guard targeted tests"
(cd "$repo_dir/tiffany-ui/codex-rs" && tiffany_fork_cargo test -p codex-tui tiffany_runtime_marker_disables_upstream_update_checks)

if [[ "$mode" == "full" || -n "$release_tag" || "${TIFFANY_PREFLIGHT_CODEX_TUI_LIB:-0}" == "1" ]]; then
  step "tiffany codex-tui serial lib tests"
  "$repo_dir/scripts/tiffany-codex-tui-lib-test"
fi

if [[ "$mode" == "full" ]]; then
  step "tiffany dist preflight"
  "$repo_dir/scripts/tiffany-check" --dist
fi

step "result"
echo "release preflight passed ($mode)"
