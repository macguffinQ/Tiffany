#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

fail=0

section() {
  printf '\n== %s ==\n' "$1"
}

section "tracked local state"
tracked_state="$(
  git ls-files |
    rg '(^|/)(target|\.orchestrator|\.tiffany|sessions)(/|$)|\.(db|sqlite|sqlite3|db-wal|db-shm|db-journal|log)$|(^|/)\.env(\.|$)|(^|/)(id_rsa|id_ed25519)(\.pub)?$|(^|/)config\.local\.ya?ml$' || true
)"
tracked_state="$(
  printf '%s\n' "${tracked_state}" |
    rg -v '^(third_party/openai-codex/|tiffany-ui/codex-rs/).*tests/fixtures/.*\.(jsonl|pem)$' || true
)"
if [[ -n "${tracked_state}" ]]; then
  echo "${tracked_state}"
  fail=1
else
  echo "ok"
fi

section "untracked suspicious files"
untracked_state="$(
  git ls-files --others --exclude-standard |
    rg '(^|/)(target|\.orchestrator|\.tiffany|sessions)(/|$)|\.(db|sqlite|sqlite3|db-wal|db-shm|db-journal|log|jsonl|pem|key)$|(^|/)\.env(\.|$)|(^|/)(id_rsa|id_ed25519)(\.pub)?$|(^|/)config(\.local)?\.ya?ml$' || true
)"
untracked_state="$(
  printf '%s\n' "${untracked_state}" |
    rg -v '^(third_party/openai-codex/|tiffany-ui/codex-rs/).*tests/fixtures/.*\.(jsonl|pem)$' || true
)"
if [[ -n "${untracked_state}" ]]; then
  echo "${untracked_state}"
  fail=1
else
  echo "ok"
fi

section "large files over 50 MiB"
large_files="$(
  find . \
    -path './.git' -prune -o \
    -path './target' -prune -o \
    -path './tiffany-ui/codex-rs/target' -prune -o \
    -type f -size +50M -print
)"
if [[ -n "${large_files}" ]]; then
  echo "${large_files}"
  fail=1
else
  echo "ok"
fi

section "common secret patterns"
secret_matches="$(
  git grep -nE \
    'sk-[A-Za-z0-9_-]{20,}|ANTHROPIC_API_KEY=[^}$[:space:]]|OPENAI_API_KEY=[^}$[:space:]]|GITHUB_TOKEN=[^}$[:space:]]|BEGIN (RSA|OPENSSH|PRIVATE) KEY|xox[baprs]-[A-Za-z0-9-]+' \
    -- . \
    ':!scripts/open-source-audit' \
    ':!Cargo.lock' \
    ':!README.md' \
    ':!README.zh-CN.md' \
    ':!third_party/**' \
    ':!docs/open-source-checklist.md' \
    ':!tiffany-ui/**/tests/**' \
    ':!tiffany-ui/codex-rs/agent-identity/src/lib.rs' \
    ':!tiffany-ui/codex-rs/cli/src/login.rs' \
    ':!tiffany-ui/codex-rs/login/src/auth/auth_tests.rs' \
    ':!tiffany-ui/codex-rs/memories/write/src/phase1.rs' \
    ':!tiffany-ui/codex-rs/core/src/tools/runtimes/mod_tests.rs' || true
)"
if [[ -n "${secret_matches}" ]]; then
  echo "${secret_matches}"
  fail=1
else
  echo "ok"
fi

section "misleading upstream user docs"
upstream_user_docs="$(
  git grep -nE \
    'developers\.openai\.com/codex|@openai/codex|brew install --cask codex|brew upgrade --cask codex|npm install -g @openai/codex|github\.com/openai/codex/issues/new|bugcrowd\.com/engagements/openai|security@openai\.com|Codex open source fund|Codex team does not accept' \
    -- \
    tiffany-ui/docs \
    tiffany-ui/SECURITY.md \
    tiffany-ui/README.md \
    tiffany-ui/codex-rs/cli/src \
    tiffany-ui/codex-rs/config/src \
    tiffany-ui/codex-rs/core/src \
    tiffany-ui/codex-rs/tui/src \
    ':!tiffany-ui/codex-rs/cli/src/doctor.rs' \
    ':!tiffany-ui/codex-rs/**/tests/**' \
    ':!tiffany-ui/codex-rs/**/snapshots/**' \
    ':!tiffany-ui/codex-rs/**/*_tests.rs' \
    ':!tiffany-ui/codex-rs/tui/src/markdown_render_tests.rs' \
    ':!tiffany-ui/codex-rs/tui/src/branch_summary.rs' \
    ':!tiffany-ui/codex-rs/tui/src/chatwidget/tests/**' \
    ':!tiffany-ui/codex-rs/tui/src/bottom_pane/chat_composer.rs' \
    || true
)"
if [[ -n "${upstream_user_docs}" ]]; then
  echo "${upstream_user_docs}"
  fail=1
else
  echo "ok"
fi

section "stale release examples"
stale_release_examples="$(
  git grep -nE 'v0\.[0-9]+\.[0-9]+' -- \
    README.md \
    README.zh-CN.md \
    packaging/homebrew/tiffany-loop.rb \
    || true
)"
if [[ -n "${stale_release_examples}" ]]; then
  echo "${stale_release_examples}"
  fail=1
else
  echo "ok"
fi

section "result"
if [[ "${fail}" -ne 0 ]]; then
  echo "open-source audit failed"
  exit 1
fi

echo "open-source audit passed"
