#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo_dir/scripts/lib/tiffany-cargo.sh"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  printf '%s\n' \
    "Usage: ./scripts/tiffany-build [cargo-build-args...]" \
    "" \
    "Builds runtime and UI binaries:" \
    "  - target/*/orchestrator" \
    "  - target/*/tiffany-loop (plus tiffany compatibility alias)" \
    "" \
    "Default profile: --small (target/dev-small). Use --dev for Cargo's normal debug profile." \
    "" \
    "Examples:" \
    "  ./scripts/tiffany-build" \
    "  ./scripts/tiffany-build --small --locked" \
    "  ./scripts/tiffany-build --dev --locked" \
    "  ./scripts/tiffany-build --release --locked" \
    "  ./scripts/tiffany-build --fast-release --locked" \
    "  ./scripts/tiffany-build --fast-release --locked --prune-dist-cache" \
    "" \
    "Environment:" \
    "  TIFFANY_CARGO_TARGET_DIR  shared Cargo target dir, default: ./target" \
    "  TIFFANY_NO_STRIP=1        keep symbols in --fast-release binaries" \
    "  TIFFANY_PRUNE_DIST_CACHE=1 remove dist build cache after a successful build"
  exit 0
fi

cargo_bin="$(tiffany_resolve_cargo)"

target_dir="${TIFFANY_CARGO_TARGET_DIR:-${CARGO_TARGET_DIR:-$repo_dir/target}}"
case "$target_dir" in
  /*) ;;
  *) target_dir="$repo_dir/$target_dir" ;;
esac
export CARGO_TARGET_DIR="$target_dir"

cargo_flags=()
dist_mode=0
prune_dist_cache="${TIFFANY_PRUNE_DIST_CACHE:-0}"
build_target=""
expect_target=0
explicit_profile=0
prev_arg=""
for arg in "$@"; do
  if [[ "$expect_target" == "1" ]]; then
    build_target="$arg"
    expect_target=0
  fi

  case "$arg" in
    --fast-release|--dist)
      explicit_profile=1
      dist_mode=1
      cargo_flags+=(--profile tiffany-dist)
      ;;
    --small|--small-debug)
      explicit_profile=1
      cargo_flags+=(--profile dev-small)
      ;;
    --dev|--debug)
      explicit_profile=1
      ;;
    --prune-dist-cache)
      prune_dist_cache=1
      ;;
    --profile=tiffany-dist)
      explicit_profile=1
      dist_mode=1
      cargo_flags+=("$arg")
      ;;
    --profile|--profile=*)
      explicit_profile=1
      cargo_flags+=("$arg")
      ;;
    --release)
      explicit_profile=1
      cargo_flags+=("$arg")
      ;;
    --target)
      expect_target=1
      cargo_flags+=("$arg")
      ;;
    --target=*)
      build_target="${arg#--target=}"
      cargo_flags+=("$arg")
      ;;
    tiffany-dist)
      if [[ "$prev_arg" == "--profile" ]]; then
        explicit_profile=1
        dist_mode=1
      fi
      cargo_flags+=("$arg")
      ;;
    *)
      cargo_flags+=("$arg")
      ;;
  esac
  prev_arg="$arg"
done
if [[ "$explicit_profile" == "0" ]]; then
  cargo_flags=(--profile dev-small "${cargo_flags[@]}")
fi
if [[ "${TIFFANY_QUIET:-0}" == "1" ]]; then
  cargo_flags+=(--quiet)
fi
run_build() {
  local label="$1"
  local dir="$2"
  shift 2

  echo "building $label..."
  if [[ "${TIFFANY_QUIET:-0}" == "1" ]]; then
    local log_file
    log_file="$(mktemp)"
    if ! (cd "$dir" && "$cargo_bin" build "${cargo_flags[@]}" "$@" >"$log_file" 2>&1); then
      cat "$log_file" >&2
      rm -f "$log_file"
      exit 1
    fi
    rm -f "$log_file"
    return
  fi

  (cd "$dir" && "$cargo_bin" build "${cargo_flags[@]}" "$@")
}

run_build "orchestrator" "$repo_dir" --bin orchestrator
run_build "tiffany-loop UI" "$repo_dir/tiffany-ui/codex-rs" -p tiffany-cli --bin tiffany-loop --bin tiffany

if [[ "$dist_mode" == "1" && "${TIFFANY_NO_STRIP:-0}" != "1" ]]; then
  case "$(uname -s)" in
    Darwin|Linux)
      if command -v strip >/dev/null 2>&1; then
        for binary in "$target_dir/tiffany-dist/orchestrator" "$target_dir/tiffany-dist/tiffany-loop" "$target_dir/tiffany-dist/tiffany"; do
          if [[ -x "$binary" ]]; then
            echo "stripping $(basename "$binary")..."
            strip "$binary" || true
          fi
        done
      fi
      ;;
  esac
fi

if [[ "$dist_mode" == "1" && "$prune_dist_cache" == "1" ]]; then
  profile_dir="$target_dir/tiffany-dist"
  if [[ -n "$build_target" ]]; then
    profile_dir="$target_dir/$build_target/tiffany-dist"
  fi

  if [[ -d "$profile_dir" ]]; then
    echo "pruning dist build cache while keeping final binaries..."
    for entry in .fingerprint build deps examples incremental gn_out; do
      if [[ -e "$profile_dir/$entry" ]]; then
        rm -rf "$profile_dir/$entry"
      fi
    done
  fi
fi

echo "done"
