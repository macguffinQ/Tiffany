#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  printf '%s\n' \
    "Usage: ./scripts/tiffany-build [cargo-build-args...]" \
    "" \
    "Builds both binaries:" \
    "  - target/*/orchestrator" \
    "  - target/*/tiffany" \
    "" \
    "Examples:" \
    "  ./scripts/tiffany-build" \
    "  ./scripts/tiffany-build --release --locked" \
    "  ./scripts/tiffany-build --fast-release --locked" \
    "" \
    "Environment:" \
    "  TIFFANY_CARGO_TARGET_DIR  shared Cargo target dir, default: ./target" \
    "  TIFFANY_NO_STRIP=1        keep symbols in --fast-release binaries" \
    "  TIFFANY_CODE_MODE_RUNTIME=1" \
    "                            include the heavier Codex code-mode/V8 runtime"
  exit 0
fi

cargo_bin="${CARGO:-cargo}"
if ! command -v "$cargo_bin" >/dev/null 2>&1; then
  cargo_bin="$HOME/.cargo/bin/cargo"
fi

target_dir="${TIFFANY_CARGO_TARGET_DIR:-${CARGO_TARGET_DIR:-$repo_dir/target}}"
case "$target_dir" in
  /*) ;;
  *) target_dir="$repo_dir/$target_dir" ;;
esac
export CARGO_TARGET_DIR="$target_dir"

cargo_flags=()
dist_mode=0
prev_arg=""
for arg in "$@"; do
  case "$arg" in
    --fast-release|--dist)
      dist_mode=1
      cargo_flags+=(--profile tiffany-dist)
      ;;
    --profile=tiffany-dist)
      dist_mode=1
      cargo_flags+=("$arg")
      ;;
    tiffany-dist)
      if [[ "$prev_arg" == "--profile" ]]; then
        dist_mode=1
      fi
      cargo_flags+=("$arg")
      ;;
    *)
      cargo_flags+=("$arg")
      ;;
  esac
  prev_arg="$arg"
done
if [[ "${TIFFANY_QUIET:-0}" == "1" ]]; then
  cargo_flags+=(--quiet)
fi
ui_flags=()
if [[ "${TIFFANY_CODE_MODE_RUNTIME:-0}" == "1" ]]; then
  ui_flags+=(--features code-mode-runtime)
fi

run_build() {
  local label="$1"
  local dir="$2"
  shift 2

  echo "building $label..."
  if [[ "${TIFFANY_QUIET:-0}" == "1" ]]; then
    local log_file
    log_file="$(mktemp)"
    if ! (cd "$dir" && "$cargo_bin" build "${cargo_flags[@]}" "$@" >"$log_file" 2>&1); then
      cat "$log_file" >&2
      rm -f "$log_file"
      exit 1
    fi
    rm -f "$log_file"
    return
  fi

  (cd "$dir" && "$cargo_bin" build "${cargo_flags[@]}" "$@")
}

run_build "orchestrator" "$repo_dir" --bin orchestrator
run_build "tiffany-loop UI" "$repo_dir/tiffany-ui/codex-rs" "${ui_flags[@]}" -p codex-cli --bin tiffany

if [[ "$dist_mode" == "1" && "${TIFFANY_NO_STRIP:-0}" != "1" ]]; then
  case "$(uname -s)" in
    Darwin|Linux)
      if command -v strip >/dev/null 2>&1; then
        for binary in "$target_dir/tiffany-dist/orchestrator" "$target_dir/tiffany-dist/tiffany"; do
          if [[ -x "$binary" ]]; then
            echo "stripping $(basename "$binary")..."
            strip "$binary" || true
          fi
        done
      fi
      ;;
  esac
fi

echo "done"
