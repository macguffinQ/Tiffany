#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./scripts/tiffany-clean-targets
      Remove the old tiffany-ui/codex-rs/target directory. New direct Cargo
      commands in the fork are redirected to the shared ./target directory.

  ./scripts/tiffany-clean-targets --sizes
      Show shared and legacy target directory sizes.

  ./scripts/tiffany-clean-targets --top [N]
      Show the largest direct entries under target directories. Defaults to 20
      entries per directory.

  ./scripts/tiffany-clean-targets --top-deep [N]
      Also scan debug deps and incremental internals. This is slower but useful
      when the top-level output is not enough.

  ./scripts/tiffany-clean-targets --incremental
      Remove Cargo incremental caches while keeping compiled deps and binaries.

  ./scripts/tiffany-clean-targets --dist
      Remove tiffany-dist build outputs from shared and legacy target dirs.

  ./scripts/tiffany-clean-targets --dist-cache
      Remove tiffany-dist cache internals while keeping final binaries.

  ./scripts/tiffany-clean-targets --debug
      Remove debug build outputs from shared and legacy target dirs.

  ./scripts/tiffany-clean-targets --all
      Remove both ./target and tiffany-ui/codex-rs/target.

  ./scripts/tiffany-clean-targets --dry-run --dist-cache
      Print what would be removed without deleting files.

By default the shared ./target directory is kept, so normal incremental builds
remain warm. The fork-local target is a legacy duplicate cache.
EOF
}

legacy_target="$repo_dir/tiffany-ui/codex-rs/target"
shared_target="$repo_dir/target"
mode="legacy"
dry_run=0
top_limit=20

while [[ "$#" -gt 0 ]]; do
  arg="$1"
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=1
      ;;
    --sizes)
      mode="sizes"
      ;;
    --top)
      mode="top"
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        top_limit="$2"
        shift
      fi
      ;;
    --top=*)
      mode="top"
      top_limit="${arg#--top=}"
      if [[ ! "$top_limit" =~ ^[0-9]+$ ]]; then
        usage >&2
        exit 2
      fi
      ;;
    --top-deep)
      mode="top-deep"
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        top_limit="$2"
        shift
      fi
      ;;
    --top-deep=*)
      mode="top-deep"
      top_limit="${arg#--top-deep=}"
      if [[ ! "$top_limit" =~ ^[0-9]+$ ]]; then
        usage >&2
        exit 2
      fi
      ;;
    --incremental)
      mode="incremental"
      ;;
    --dist)
      mode="dist"
      ;;
    --dist-cache)
      mode="dist-cache"
      ;;
    --debug)
      mode="debug"
      ;;
    --legacy)
      mode="legacy"
      ;;
    --all)
      mode="all"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

size_of() {
  local path="$1"
  if [[ -e "$path" ]]; then
    du -sh "$path" 2>/dev/null || true
  else
    printf '0B\t%s\n' "$path"
  fi
}

remove_path() {
  local label="$1"
  local path="$2"
  if [[ ! -e "$path" ]]; then
    echo "$label already absent: $path"
    return
  fi

  if [[ "$dry_run" == "1" ]]; then
    printf 'would remove %s: ' "$label"
    size_of "$path"
    return
  fi

  echo "removing $label: $path"
  rm -rf "$path"
}

show_sizes() {
  echo "shared target:"
  size_of "$shared_target"
  size_of "$shared_target/debug"
  size_of "$shared_target/debug/deps"
  size_of "$shared_target/debug/incremental"
  size_of "$shared_target/tiffany-dist"
  size_of "$shared_target/release"
  echo
  echo "legacy target:"
  size_of "$legacy_target"
  size_of "$legacy_target/debug"
  size_of "$legacy_target/debug/deps"
  size_of "$legacy_target/debug/incremental"
  size_of "$legacy_target/tiffany-dist"
  size_of "$legacy_target/release"
}

show_top_dir() {
  local label="$1"
  local dir="$2"
  if [[ ! -d "$dir" ]]; then
    return
  fi

  echo
  echo "$label:"
  find "$dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null \
    | xargs -0 du -sh 2>/dev/null \
    | sort -h \
    | tail -n "$top_limit" \
    || true
}

show_top() {
  show_top_dir "shared target top entries" "$shared_target"
  show_top_dir "shared debug top entries" "$shared_target/debug"
  show_top_dir "shared tiffany-dist top entries" "$shared_target/tiffany-dist"
  show_top_dir "legacy target top entries" "$legacy_target"
}

show_top_deep() {
  show_top
  show_top_dir "shared debug deps top entries" "$shared_target/debug/deps"
  show_top_dir "shared debug incremental top entries" "$shared_target/debug/incremental"
  show_top_dir "legacy debug deps top entries" "$legacy_target/debug/deps"
  show_top_dir "legacy debug incremental top entries" "$legacy_target/debug/incremental"
}

remove_dist_cache() {
  local target_root="$1"
  local label="$2"
  local profile_dir="$target_root/tiffany-dist"
  if [[ ! -d "$profile_dir" ]]; then
    echo "$label dist cache already absent: $profile_dir"
    return
  fi

  for entry in .fingerprint build deps examples incremental gn_out; do
    remove_path "$label tiffany-dist/$entry" "$profile_dir/$entry"
  done
}

case "$mode" in
  sizes)
    show_sizes
    ;;
  top)
    show_top
    ;;
  top-deep)
    show_top_deep
    ;;
  incremental)
    remove_path "shared debug incremental cache" "$shared_target/debug/incremental"
    remove_path "shared tiffany-dist incremental cache" "$shared_target/tiffany-dist/incremental"
    remove_path "legacy debug incremental cache" "$legacy_target/debug/incremental"
    remove_path "legacy tiffany-dist incremental cache" "$legacy_target/tiffany-dist/incremental"
    ;;
  dist)
    remove_path "shared tiffany-dist target" "$shared_target/tiffany-dist"
    remove_path "legacy tiffany-dist target" "$legacy_target/tiffany-dist"
    ;;
  dist-cache)
    remove_dist_cache "$shared_target" "shared"
    remove_dist_cache "$legacy_target" "legacy"
    ;;
  debug)
    remove_path "shared debug target" "$shared_target/debug"
    remove_path "legacy debug target" "$legacy_target/debug"
    ;;
  legacy)
    remove_path "legacy target" "$legacy_target"
    ;;
  all)
    remove_path "legacy target" "$legacy_target"
    remove_path "shared target" "$shared_target"
    ;;
esac
